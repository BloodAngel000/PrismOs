# Step 1: Assembler le fichier d'amorce boot.s
nasm -f elf32 boot.s -o boot.o

# Step 2: Compiler le fichier C kernel.c
gcc -m32 -c kernel.c -o kernel.o -std=gnu99 -ffreestanding -O2 -Wall -Wextra

# Step 3: Lier les objets avec linker.ld pour créer l'image binaire du kernel
ld -m elf_i386 -T linker.ld -o mykernel.bin boot.o kernel.o

# Step 4: Lancer ton kernel dans QEMU
qemu-system-i386 -kernel mykernel.bin
